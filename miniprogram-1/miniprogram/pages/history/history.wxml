<view class="history-container">
  <view class="page-header">
    <text class="page-title">我的面试战绩</text>
    <text class="page-subtitle">每一次复盘，都是向Offer迈进的一步</text>
  </view>

  <!-- Tab 栏 -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 0 ? 'tab-active' : ''}}" data-tab="0" bindtap="switchTab">
      <text>自行模拟面试</text>
      <view wx:if="{{activeTab === 0}}" class="tab-indicator"></view>
    </view>
    <view class="tab-item {{activeTab === 1 ? 'tab-active' : ''}}" data-tab="1" bindtap="switchTab">
      <text>企业面试</text>
      <view wx:if="{{activeTab === 1}}" class="tab-indicator"></view>
    </view>
  </view>

  <!-- 自行模拟面试列表 -->
  <scroll-view wx:if="{{activeTab === 0}}" class="record-list" scroll-y="true">
    <block wx:for="{{selfRecords}}" wx:key="id">
      <view class="record-card" bindtap="toggleExpand" data-index="{{index}}">
        <view class="record-summary">
          <view class="record-info">
            <text class="job-title">{{item.jobTitle}}</text>
            <text class="interview-date">{{item.date}}</text>
          </view>
          <view class="record-score">
            <text class="score-num {{item.score >= 80 ? 'high-score' : 'normal-score'}}">{{item.score}}</text>
            <text class="score-label">分</text>
          </view>
          <text class="expand-icon">{{item._expanded ? '▲' : '▼'}}</text>
        </view>

        <view wx:if="{{item._expanded}}" class="chat-detail">
          <view class="divider"></view>
          <block wx:for="{{item.chatHistory}}" wx:for-index="msgIdx" wx:key="msgIdx">
            <view class="msg-row {{item.role === 'user' ? 'msg-user-row' : 'msg-ai-row'}}">
              <view class="msg-bubble {{item.role === 'user' ? 'msg-user' : 'msg-ai'}} {{item.role === 'system' ? 'msg-system' : ''}}">
                <text class="msg-label" wx:if="{{item.role === 'user'}}">我</text>
                <text class="msg-label" wx:elif="{{item.role === 'ai'}}">AI 面试官</text>
                <text class="msg-label" wx:else>系统提示</text>
                <text class="msg-content">{{item.content}}</text>
              </view>
            </view>
          </block>
          <view wx:if="{{!item.chatHistory || item.chatHistory.length === 0}}" class="no-chat">
            <text>暂无对话内容</text>
          </view>
        </view>
      </view>
    </block>

    <view wx:if="{{selfRecords.length === 0}}" class="empty-state">
      <text class="empty-text">暂无自行模拟面试记录，快去大厅开启第一次挑战吧！</text>
    </view>
  </scroll-view>

  <!-- 企业面试列表 -->
  <scroll-view wx:if="{{activeTab === 1}}" class="record-list" scroll-y="true">
    <block wx:for="{{companyRecords}}" wx:key="id">
      <view class="record-card" bindtap="toggleExpand" data-index="{{index}}">
        <view class="record-summary">
          <view class="record-info">
            <text class="company-tag">{{item.companyName}}</text>
            <text class="job-title">{{item.jobTitle}}</text>
            <text class="interview-date">{{item.date}}</text>
          </view>
          <view class="record-score">
            <text class="score-num {{item.score >= 80 ? 'high-score' : 'normal-score'}}">{{item.score}}</text>
            <text class="score-label">分</text>
          </view>
          <text class="expand-icon">{{item._expanded ? '▲' : '▼'}}</text>
        </view>

        <view wx:if="{{item._expanded}}" class="chat-detail">
          <view class="divider"></view>
          <block wx:for="{{item.chatHistory}}" wx:for-index="msgIdx" wx:key="msgIdx">
            <view class="msg-row {{item.role === 'user' ? 'msg-user-row' : 'msg-ai-row'}}">
              <view class="msg-bubble {{item.role === 'user' ? 'msg-user' : 'msg-ai'}} {{item.role === 'system' ? 'msg-system' : ''}}">
                <text class="msg-label" wx:if="{{item.role === 'user'}}">求职者</text>
                <text class="msg-label" wx:elif="{{item.role === 'ai'}}">AI 面试官</text>
                <text class="msg-label" wx:else>系统提示</text>
                <text class="msg-content">{{item.content}}</text>
              </view>
            </view>
          </block>
          <view wx:if="{{!item.chatHistory || item.chatHistory.length === 0}}" class="no-chat">
            <text>暂无对话内容</text>
          </view>
        </view>
      </view>
    </block>

    <view wx:if="{{companyRecords.length === 0}}" class="empty-state">
      <text class="empty-text">暂无企业面试记录</text>
    </view>
  </scroll-view>
</view>
