page {
  background-color: #f7f9fc;
}

.history-container {
  padding: 40rpx;
}

.page-header {
  margin-bottom: 40rpx;
}

/* Tab 栏 */
.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #888;
  position: relative;
}

.tab-active {
  color: #4a90e2;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  width: 60rpx;
  height: 4rpx;
  background: #4a90e2;
  border-radius: 2rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #888;
}

.record-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.record-summary {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.company-tag {
  display: inline-block;
  background: #e8f4fd;
  color: #4a90e2;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  align-self: flex-start;
}

.job-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.interview-date {
  font-size: 24rpx;
  color: #999;
}

.record-score {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.score-num {
  font-size: 56rpx;
  font-weight: 900;
  font-family: 'Courier New', Courier, monospace;
}

.score-label {
  font-size: 24rpx;
  color: #888;
}

.high-score { color: #07c160; }
.normal-score { color: #ff9800; }

.expand-icon {
  font-size: 24rpx;
  color: #ccc;
  margin-left: 10rpx;
}

.divider {
  height: 2rpx;
  background: #f0f0f0;
  margin: 24rpx 0;
}

.chat-detail {
  max-height: 1200rpx;
  overflow-y: auto;
}

.msg-row {
  display: flex;
  margin-bottom: 20rpx;
}

.msg-user-row {
  justify-content: flex-end;
}

.msg-ai-row {
  justify-content: flex-start;
}

.msg-bubble {
  max-width: 80%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.msg-user {
  background: #4a90e2;
  color: #fff;
  border-bottom-right-radius: 4rpx;
}

.msg-ai {
  background: #f0f0f0;
  color: #333;
  border-bottom-left-radius: 4rpx;
}

.msg-system {
  background: #fef8e7;
  color: #b8860b;
  align-self: center;
  max-width: 90%;
  border-radius: 8rpx;
  font-size: 24rpx;
  text-align: center;
}

.msg-label {
  font-size: 22rpx;
  opacity: 0.7;
}

.msg-content {
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.no-chat {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 40rpx 0;
}

.empty-state {
  display: flex;
  justify-content: center;
  margin-top: 100rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
