<view class="job-picker-area" style="margin-bottom: 30rpx; display: flex; flex-direction: column; align-items: center;">
  <view class="lobby-container" wx:if="{{!isInterviewing}}">
    <view class="role-switch-box">
      <view class="role-btn {{userRole === 'candidate' ? 'active-role' : ''}}" bindtap="switchToCandidate">🧑‍🎓 我是求职者</view>
      <view class="role-btn" bindtap="switchToHr">🏢 我是企业HR</view>
    </view>

    <!-- 求职者企业开关 -->
    <view wx:if="{{userRole === 'candidate' && companies.length > 0}}" class="company-toggle">
      <view class="toggle-row">
        <text class="toggle-label">使用企业配置</text>
        <view class="switch {{useCompany ? 'switch-on' : 'switch-off'}}" bindtap="toggleCompany">
          <view class="switch-knob {{useCompany ? 'knob-on' : 'knob-off'}}"></view>
        </view>
      </view>
      <view wx:if="{{useCompany}}" class="company-picker-box">
        <picker bindchange="onCompanyChange" value="{{companyIndex}}" range="{{companies}}" range-key="{{'companyName'}}">
          <view class="company-picker-btn">
            <text style="color: #666; font-size: 28rpx;">🏢 目标企业：</text>
            <text style="color: #4a90e2; font-weight: bold; font-size: 30rpx; margin: 0 10rpx;">{{companies[companyIndex].companyName}}</text>
            <text style="color: #ccc; font-size: 24rpx;">▼</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="header-card">
      <text class="title">欢迎来到面辅精灵</text>
      <text class="subtitle">AI 驱动的沉浸式面试训练营</text>
    </view>

    <view class="stats-board">
      <view class="stat-item">
        <text class="stat-num">{{interviewCount}}</text>
        <text class="stat-label">面试次数</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{avgScore}}</text>
        <text class="stat-label">平均得分</text>
      </view>
    </view>
  </view>

  <picker bindchange="onJobChange" value="{{jobIndex}}" range="{{jobList}}">
    <view class="job-picker-btn">
      <text style="color: #666; font-size: 28rpx;">🎯 目标岗位：</text>
      <text style="color: #4a90e2; font-weight: bold; font-size: 30rpx; margin: 0 10rpx;">{{jobList[jobIndex]}}</text>
      <text style="color: #ccc; font-size: 24rpx;">▼</text>
    </view>
  </picker>
  <view wx:if="{{jobList[jobIndex] === '自定义岗位 ✍️'}}" style="margin-top: 20rpx; width: 80%;">
    <input type="text" placeholder="请输入你想面试的岗位..." value="{{customJob}}" bindinput="onCustomJobInput" style="background: #fff; padding: 20rpx 30rpx; border-radius: 40rpx; text-align: center; font-size: 28rpx; border: 2rpx dashed #4a90e2; color: #333;" />
  </view>

  <view wx:if="{{userRole === 'candidate'}}" style="margin-top: 20rpx; width: 80%;">
    <input type="text" placeholder="请输入你的姓名（选填）" value="{{candidateName}}" bindinput="onNameInput" style="background: #fff; padding: 20rpx 30rpx; border-radius: 40rpx; text-align: center; font-size: 28rpx; border: 2rpx solid #e0e0e0; color: #333;" />
  </view>
</view>

<view class="action-area">
  <button class="start-btn" bindtap="goToInterview">{{useCompany ? '🚀 开始企业面试' : '🚀 开始模拟面试'}}</button>
  <text class="hint-text">点击开始，直面 AI 面试官</text>
</view>
