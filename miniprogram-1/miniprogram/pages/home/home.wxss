/* pages/home/home.wxss */
page {
  background-color: #f7f9fc;
}

.home-container {
  padding: 40rpx;
}

/* 顶部蓝色渐变卡片 */
.header-card {
  background: linear-gradient(135deg, #4a90e2, #5c9ce6);
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  color: white;
  box-shadow: 0 10rpx 30rpx rgba(74, 144, 226, 0.3);
  width: 100%;
  margin: 0 auto 40rpx auto;
  box-sizing: border-box;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 中间白色的数据看板 */
.stats-board {
  display: flex;
  justify-content: space-around;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  margin-bottom: 80rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 52rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #888888;
}

/* 底部按钮区域 */
.action-area {
  text-align: center;
  margin-top: 40rpx;
}

/* 绿色发光大按钮 */
.start-btn {
  background: #07c160;
  color: white;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 50rpx;
  padding: 20rpx 0;
  width: 80%;
  box-shadow: 0 10rpx 24rpx rgba(7, 193, 96, 0.3);
  margin-bottom: 24rpx;
}

.start-btn::after {
  border: none;
}

.hint-text {
  font-size: 24rpx;
  color: #aaaaaa;
}

/* 双身份切换 UI */
.role-switch-box {
  display: flex;
  background-color: #f0f0f0;
  border-radius: 60rpx;
  padding: 8rpx;
  margin: 40rpx auto 30rpx;
  width: 88%;
}

.role-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 50rpx;
  transition: all 0.3s ease;
  white-space: nowrap;
}

.active-role {
  background-color: #fff;
  color: #4a90e2;
  font-weight: bold;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
}

/* 企业开关区 */
.company-toggle {
  width: 88%;
  margin: 0 auto 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.toggle-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.toggle-label {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

/* 自定义开关（复用 assessment 页样式） */
.switch {
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  padding: 4rpx;
  transition: background 0.2s;
}

.switch-on { background: #07c160; }
.switch-off { background: #ddd; }

.switch-knob {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
  transition: transform 0.2s;
}

.knob-on { transform: translateX(40rpx); }
.knob-off { transform: translateX(0); }

/* 企业选择器 */
.company-picker-box {
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
}

.company-picker-btn {
  background: #fff;
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
  display: inline-block;
  border: 2rpx solid #e8f0fe;
}

/* 岗位选择器 */
.job-picker-btn {
  background: #fff;
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
  display: inline-block;
}
