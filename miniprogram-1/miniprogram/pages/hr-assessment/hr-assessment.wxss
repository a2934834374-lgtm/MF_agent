page {
  background-color: #f7f9fc;
}

.container {
  padding: 40rpx;
  padding-bottom: 120rpx;
}

.page-header {
  margin-bottom: 40rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #888;
}

/* 大类卡片 */
.category-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 32rpx;
}

.category-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.category-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.category-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.disabled-text {
  color: #bbb;
}

/* 自定义开关 */
.switch {
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  padding: 4rpx;
  transition: background 0.2s;
}

.switch-on {
  background: #07c160;
}

.switch-off {
  background: #ddd;
}

.switch-knob {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
  transition: transform 0.2s;
}

.knob-on {
  transform: translateX(40rpx);
}

.knob-off {
  transform: translateX(0);
}

.count-badge {
  font-size: 22rpx;
  color: #07c160;
  background: #e8f8ee;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.expand-btn {
  font-size: 24rpx;
  color: #ccc;
  padding: 10rpx;
}

/* 子项列表 */
.item-list {
  border-top: 2rpx solid #f0f0f0;
  padding: 16rpx 32rpx 20rpx;
}

.item-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f8f8f8;
}

.item-row:last-child {
  border-bottom: none;
}

.item-checked {
  background: #f0f7ff;
  margin: 0 -32rpx;
  padding: 20rpx 32rpx;
  border-radius: 8rpx;
  border-bottom: none;
}

/* 自定义 checkbox */
.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox-checked {
  background: #4a90e2;
}

.checkbox-unchecked {
  background: #f0f0f0;
  border: 2rpx solid #ddd;
}

.checkmark {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.item-label {
  font-size: 28rpx;
  color: #333;
}

/* 底部按钮 */
.footer-actions {
  margin-top: 40rpx;
}

.save-btn {
  background: #007AFF;
  color: #fff;
  border-radius: 45rpx;
}
