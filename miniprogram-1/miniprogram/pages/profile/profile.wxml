<view class="profile-container">
  
  <view class="user-header">
    <image class="user-avatar" src="https://img.icons8.com/color/96/000000/user-male-circle--v1.png"></image>
    <view class="user-info">
      <text class="user-name">面试达人</text>
      <text class="user-desc">已坚持模拟面试 3 天，继续保持！</text>
    </view>
  </view>

  <view class="menu-list">
    
    <view class="menu-item" bindtap="handleMenuClick" data-type="resume">
      <view class="menu-left">
        <text class="menu-icon">📄</text>
        <text class="menu-text">我的默认简历</text>
      </view>
      <text class="arrow">></text>
    </view>

    <view class="menu-item" bindtap="handleMenuClick" data-type="settings">
      <view class="menu-left">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">面试偏好设置</text>
      </view>
      <text class="arrow">></text>
    </view>

    <view class="menu-item" bindtap="handleMenuClick" data-type="about">
      <view class="menu-left">
        <text class="menu-icon">💡</text>
        <text class="menu-text">关于面辅精灵</text>
      </view>
      <text class="arrow">></text>
    </view>

  </view>

  <view class="logout-btn" bindtap="clearCache">清除本地缓存</view>

</view>